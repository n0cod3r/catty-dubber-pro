{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catty Dubber Pro",
  "version": "0.1.0",
  "identifier": "com.catty.dubber.pro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Catty Dubber Pro",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$VIDEO/**",
            "$DOCUMENT/**",
            "$DOWNLOAD/**",
            "$DESKTOP/**"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
