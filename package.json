{
  "name": "catty-dubber-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --dir apps/desktop tauri dev",
    "dev:web": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop tauri build",
    "build:web": "pnpm --dir apps/desktop build",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm lint && pnpm format:check",
    "test:editor": "node --test tests/editor-*.test.mjs",
    "check:boundaries": "node scripts/check-feature-boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
